<?xml version='1.0' encoding='utf-8'?>
<widget id="com.ssh.pty.terminal" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>PTY Terminal</name>
    <description>
        PTY terminal for Android
    </description>
    <author email="suniltinku1980@gmail.com" href="https://ai.studio/build">
        AI Studio
    </author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />
    <platform name="android">
        <allow-intent href="market:*" />
        <icon src="www/app-icon.png" />
        <preference name="AndroidWindowSplashScreenAnimatedIcon" value="www/splash-icon.png" />
        <preference name="AndroidWindowSplashScreenBackground" value="#1E1E1E" />
    </platform>
</widget>
